EXPO_PUBLIC_API_BASE_URL=https://elderly-care-api.vercel.app
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-uuid
EXPO_PUBLIC_MQTT_BROKER_URL=wss://your-hivemq-host:8884/mqtt
# Use a read-only MQTT account because Expo public variables are bundled in the app.
EXPO_PUBLIC_MQTT_USERNAME=
EXPO_PUBLIC_MQTT_PASSWORD=
