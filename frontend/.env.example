# Optional overrides; these production URLs are also the source defaults.
VITE_API_URL=https://elderly-care-api.vercel.app
VITE_WS_URL=wss://elderly-care-api.vercel.app/ws/live
VITE_WS_AUTH_TOKEN=

# Optional: MQTT broker URL for direct sensor data subscription (frontend bypass).
# When set, frontend subscribes directly to MQTT topics for real-time sensor data,
# while the backend continues to handle alerts/warnings via its AMPV engine.
# A browser cannot open raw MQTT/TCP sockets, so a bare host is upgraded to the
# broker's WebSocket endpoint: wss://<host>:8884/mqtt
VITE_MQTT_BROKER_URL=

# Broker credentials. Required for brokers with authentication enabled
# (HiveMQ Cloud). These are embedded in the browser bundle — use a read-only
# broker account for production deployments.
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

