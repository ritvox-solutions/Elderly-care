# PostgreSQL connection string.
# For local throwaway development, sqlite:///./caretrack.db also works.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/caretrack

# MQTT broker. Use TLS ports such as 8883 for HiveMQ Cloud.
MQTT_BROKER_URL=YOUR_MQTT_BROKER_HOST
MQTT_PORT=8883
MQTT_USERNAME=YOUR_MQTT_USERNAME
MQTT_PASSWORD=YOUR_MQTT_PASSWORD
MQTT_USE_TLS=true

# Optional shared secret required by the HTTP telemetry webhook.
TELEMETRY_INGEST_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# Allows production and preview web deployments on Vercel.
CORS_ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# Optional WebSocket token. When set, clients must pass ?token=VALUE.
WS_AUTH_TOKEN=

# FastAPI Server Host & Port
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Emergency email notifications (fall detection / critical vitals) ---
# Leave SMTP_HOST empty to keep the pipeline inert: alerts are still saved
# and Notification rows are marked FAILED with "SMTP not configured".
EMAIL_ALERTS_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=CareTrack Alerts <alerts@example.com>
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# Minimum gap (seconds) between repeated alerts of the same category
# on the same device, so a telemetry burst cannot flood inboxes.
ALERT_COOLDOWN_SECONDS=300
FALL_ALERT_COOLDOWN_SECONDS=10

# Each onboarded patient's family email is included automatically. Extra
# addresses below receive every alert, so reserve them for a shared ward inbox.
ALERT_FALLBACK_RECIPIENTS=

# Optional: set this only if enhanced push security is enabled in Expo/EAS.
EXPO_PUSH_ACCESS_TOKEN=

# Demo-only one-tap caregiver login. Disable outside demonstrations.
ENABLE_DEMO_LOGIN=true
DEMO_CAREGIVER_EMAIL=caregiver@caretrack.health
DEMO_CAREGIVER_PASSWORD=CareTrackDemo123!
